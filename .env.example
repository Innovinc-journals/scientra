# Copy this file to .env and fill in real values. NEVER commit .env.
# NOTE: anything prefixed with VITE_ is bundled into the public JS and visible to
# every visitor. Only put PUBLIC values here (URLs). Never put secrets, API keys,
# or tokens in a VITE_ variable.

# Backend API ORIGIN only (no trailing slash, no /api/v1; the app appends /api/v1 once).
# Local backend:  http://127.0.0.1:8000
# Production:     https://api.scientrajournals.org
VITE_API_BASE_URL=http://127.0.0.1:8000
